<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#500284C7"
                android:endColor="#400369A1" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#8038BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#D00B1D36"
                android:endColor="#E0051122" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3538BDF8" />
        </shape>
    </item>
</selector>
