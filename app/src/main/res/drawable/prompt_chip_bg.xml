<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#B83D9DFF" android:endColor="#803C56D9" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#CCB9F3FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#C92B4563" android:centerColor="#8C0C1A30" android:endColor="#B8051020" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#558CEBFF" />
            <padding android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="1dp" />
        </shape>
    </item>
</selector>
