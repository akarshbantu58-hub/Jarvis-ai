<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="295"
                android:startColor="#E60D1E3A"
                android:centerColor="#D9071329"
                android:endColor="#FA030814" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#4D38BDF8" />
        </shape>
    </item>
    <item android:bottom="0dp" android:top="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#801E3A8A"
                android:centerColor="#300284C7"
                android:endColor="#00000000" />
            <corners android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
