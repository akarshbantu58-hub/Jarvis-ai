<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#400284C7"
                android:endColor="#300369A1" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#8038BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B00B1D38"
                android:endColor="#C8061427" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#2838BDF8" />
        </shape>
    </item>
</selector>
