<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_jarvis" android:padding="12dp">
    <com.jarvisai.MotionBubbleView android:id="@+id/motionBubbles" android:layout_width="0dp" android:layout_height="0dp" android:alpha="0.25" android:importantForAccessibility="no" android:clickable="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout android:id="@+id/topBar" android:layout_width="0dp" android:layout_height="68dp" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:id="@+id/logoImage" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/glass_button" android:contentDescription="JARVIS logo" android:padding="3dp" android:scaleType="centerInside"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/titleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JARVIS" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" android:letterSpacing=".08"/>
            <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR AI ASSISTANT" android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing=".08"/>
        </LinearLayout>
        <TextView android:id="@+id/timeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/glass_button" android:paddingHorizontal="12dp" android:paddingVertical="9dp" android:text="00:00" android:textColor="@color/text_secondary" android:textSize="12sp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/contentScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:overScrollMode="never" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toTopOf="@id/dock" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR PERSONAL AI" android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing=".18"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hello, I’m JARVIS." android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Your assistant. Your world. What shall we do?" android:textColor="@color/text_secondary" android:textSize="13sp"/>
          </LinearLayout>
          <FrameLayout android:layout_width="176dp" android:layout_height="176dp">
            <com.jarvisai.VoiceOrbView android:id="@+id/voiceOrb" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J" android:textColor="#FFFFFFFF" android:textSize="42sp" android:textStyle="bold"/>
              <TextView android:id="@+id/orbStateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONLINE" android:textColor="@color/accent" android:textSize="9sp" android:letterSpacing=".18"/>
            </LinearLayout>
          </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
          <TextView android:id="@+id/devCard" android:layout_width="0dp" android:layout_height="86dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/feature_card" android:clickable="true" android:focusable="true" android:foreground="@drawable/nav_item" android:gravity="center" android:text="⌘\nDEV STUDIO\nCode &amp; build" android:textColor="@color/text_primary" android:textSize="11sp"/>
          <TextView android:id="@+id/cameraCard" android:layout_width="0dp" android:layout_height="86dp" android:layout_marginHorizontal="5dp" android:layout_weight="1" android:background="@drawable/feature_card" android:clickable="true" android:focusable="true" android:foreground="@drawable/nav_item" android:gravity="center" android:text="◉\nVISION\nCamera AI" android:textColor="@color/text_primary" android:textSize="11sp"/>
          <TextView android:id="@+id/settingsCard" android:layout_width="0dp" android:layout_height="86dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/feature_card" android:clickable="true" android:focusable="true" android:foreground="@drawable/nav_item" android:gravity="center" android:text="⚙\nDEVICE\nPermissions" android:textColor="@color/text_primary" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
          <TextView android:id="@+id/aiCard" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/feature_card" android:clickable="true" android:focusable="true" android:foreground="@drawable/nav_item" android:gravity="center" android:text="✦  GEMINI AI\nConnected models" android:textColor="@color/text_primary" android:textSize="10sp"/>
          <TextView android:id="@+id/personalCard" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/feature_card" android:clickable="true" android:focusable="true" android:foreground="@drawable/nav_item" android:gravity="center" android:text="◌  MEMORY\nPersonalize JARVIS" android:textColor="@color/text_primary" android:textSize="10sp"/>
          <TextView android:id="@+id/apiCard" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/feature_card" android:clickable="true" android:focusable="true" android:foreground="@drawable/nav_item" android:gravity="center" android:text="⌁  API HUB\nKeys &amp; settings" android:textColor="@color/text_primary" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/defaultAssistantCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/glass_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="13dp">
          <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/glass_button" android:gravity="center" android:text="✦" android:textColor="@color/accent" android:textSize="20sp"/>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/defaultAssistantTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAKE JARVIS YOUR ASSISTANT" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
            <TextView android:id="@+id/defaultAssistantSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Use Android's official assistant settings" android:textColor="@color/text_secondary" android:textSize="10sp"/>
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/accent" android:textSize="26sp"/>
        </LinearLayout>
        <TextView android:id="@+id/automationCard" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="9dp" android:background="@drawable/glass_card" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="◷    AUTOMATIONS     •     Reminders and routines     ›" android:textColor="@color/text_primary" android:textSize="11sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/glass_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
          <EditText android:id="@+id/commandInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Ask JARVIS anything..." android:imeOptions="actionSend" android:singleLine="true" android:paddingStart="12dp" android:paddingEnd="8dp" android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"/>
          <ImageButton android:id="@+id/listenButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/composer_icon_button" android:contentDescription="Voice input" android:padding="11dp" android:src="@drawable/ic_mic"/>
          <Button android:id="@+id/voiceModeButton" android:layout_width="55dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:minWidth="0dp" android:background="@drawable/composer_action_button" android:textColor="@color/accent" android:paddingHorizontal="5dp" android:text="PUSH" android:textSize="9sp"/>
          <Button android:id="@+id/sendButton" android:layout_width="58dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:minWidth="0dp" android:background="@drawable/composer_send_button" android:textColor="#FFFFFFFF" android:paddingHorizontal="5dp" android:text="SEND" android:textSize="9sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginStart="4dp" android:text="JARVIS  /  RESPONSE" android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing=".14"/>
        <TextView android:id="@+id/responseText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/chat_bubble_ai" android:minHeight="68dp" android:gravity="center_vertical" android:padding="16dp" android:text="I’m ready. Ask anything or give me a command." android:textColor="@color/text_primary" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/dock" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginBottom="3dp" android:background="@drawable/glass_card" android:gravity="center" android:paddingHorizontal="5dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
      <TextView android:id="@+id/dockHome" android:layout_width="58dp" android:layout_height="48dp" android:background="@drawable/nav_item_selected" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⌂\nHOME" android:textColor="@color/accent" android:textSize="9sp"/>
      <TextView android:id="@+id/dockVoice" android:layout_width="58dp" android:layout_height="48dp" android:background="@drawable/nav_item" android:clickable="true" android:focusable="true" android:gravity="center" android:text="◉\nVOICE" android:textColor="@color/text_primary" android:textSize="9sp"/>
      <TextView android:id="@+id/dockApps" android:layout_width="58dp" android:layout_height="48dp" android:background="@drawable/nav_item" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▦\nAPPS" android:textColor="@color/text_primary" android:textSize="9sp"/>
      <TextView android:id="@+id/dockAI" android:layout_width="58dp" android:layout_height="48dp" android:background="@drawable/nav_item" android:clickable="true" android:focusable="true" android:gravity="center" android:text="✦\nAI" android:textColor="@color/text_primary" android:textSize="9sp"/>
      <TextView android:id="@+id/dockSettings" android:layout_width="58dp" android:layout_height="48dp" android:background="@drawable/nav_item" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⚙\nSET" android:textColor="@color/text_primary" android:textSize="9sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>