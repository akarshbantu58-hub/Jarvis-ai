<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_jarvis" android:padding="18dp">

    <LinearLayout android:id="@+id/topBar" android:layout_width="0dp" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/glass_button" android:gravity="center" android:text="J" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/titleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JARVIS" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:letterSpacing=".16" />
            <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● SYSTEM ONLINE" android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing=".08" />
        </LinearLayout>
        <TextView android:id="@+id/timeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="@color/text_secondary" android:textSize="13sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/contentScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:overScrollMode="never" app:layout_constraintBottom_toTopOf="@id/dock" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/topBar">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="22dp">

            <FrameLayout android:layout_width="min(88%, 420dp)" android:layout_height="min(88%, 420dp)" android:minWidth="300dp" android:minHeight="300dp" android:maxWidth="420dp" android:maxHeight="420dp">
                <com.jarvisai.JarvisCoreView android:id="@+id/jarvisCoreView" android:layout_width="match_parent" android:layout_height="match_parent" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J" android:textColor="#FFFFFFFF" android:textSize="62sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONLINE" android:textColor="@color/accent" android:textSize="9sp" android:letterSpacing=".25" />
                </LinearLayout>
            </FrameLayout>

            <TextView android:id="@+id/responseText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="28dp" android:layout_marginTop="-4dp" android:gravity="center" android:text="JARVIS is ready." android:textColor="@color/text_secondary" android:textSize="14sp" />

            <LinearLayout android:id="@+id/defaultAssistantCard" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="16dp" android:background="@drawable/glass_card" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:orientation="horizontal">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_button" android:gravity="center" android:text="✦" android:textColor="@color/accent" android:textSize="20sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                    <TextView android:id="@+id/defaultAssistantTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SET JARVIS AS DEFAULT ASSISTANT" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:letterSpacing=".04" />
                    <TextView android:id="@+id/defaultAssistantSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tap to open Android's confirmation dialog" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/accent" android:textSize="28sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <TextView android:id="@+id/devCard" android:layout_width="0dp" android:layout_height="92dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/glass_card" android:gravity="center" android:padding="10dp" android:text="⌘\nDEV STUDIO\nCode • Run" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:id="@+id/cameraCard" android:layout_width="0dp" android:layout_height="92dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/glass_card" android:gravity="center" android:padding="10dp" android:text="◉\nVISION\nCamera • AI" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:id="@+id/settingsCard" android:layout_width="0dp" android:layout_height="92dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/glass_card" android:gravity="center" android:padding="10dp" android:text="⚙\nPERMISSIONS\nAssistant • Access" android:textColor="@color/text_primary" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:id="@+id/aiCard" android:layout_width="0dp" android:layout_height="74dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/glass_card" android:gravity="center" android:text="✦  AI CORE\nReady" android:textColor="@color/text_primary" android:textSize="11sp" />
                <TextView android:id="@+id/personalCard" android:layout_width="0dp" android:layout_height="74dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/glass_card" android:gravity="center" android:text="◌  PERSONALIZE\nTheme • Voice" android:textColor="@color/text_primary" android:textSize="11sp" />
                <TextView android:id="@+id/apiCard" android:layout_width="0dp" android:layout_height="74dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/glass_card" android:gravity="center" android:text="⌁  API HUB\nKeys • Models" android:textColor="@color/text_primary" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:id="@+id/automationCard" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="10dp" android:background="@drawable/glass_card" android:gravity="center" android:text="⏱  AUTOMATIONS\nDaily reminders • Scheduled JARVIS tasks" android:textColor="@color/text_primary" android:textSize="12sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="16dp" android:background="@drawable/glass_input" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="7dp" android:orientation="horizontal">
                <EditText android:id="@+id/commandInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Ask JARVIS anything..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:singleLine="true" />
                <ImageButton android:id="@+id/listenButton" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/glass_button" android:contentDescription="Voice input" android:src="@android:drawable/ic_btn_speak_now" />
                <Button android:id="@+id/sendButton" android:layout_width="66dp" android:layout_height="50dp" android:layout_marginStart="7dp" android:text="SEND" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:id="@+id/dock" android:layout_width="wrap_content" android:layout_height="58dp" android:layout_marginBottom="4dp" android:background="@drawable/glass_card" android:gravity="center" android:paddingHorizontal="8dp" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <TextView android:id="@+id/dockHome" android:layout_width="54dp" android:layout_height="48dp" android:gravity="center" android:text="⌂\nHOME" android:textColor="@color/accent" android:textSize="9sp" />
        <TextView android:id="@+id/dockVoice" android:layout_width="54dp" android:layout_height="48dp" android:gravity="center" android:text="◉\nVOICE" android:textColor="@color/text_primary" android:textSize="9sp" />
        <TextView android:id="@+id/dockApps" android:layout_width="54dp" android:layout_height="48dp" android:gravity="center" android:text="⏱\nAUTO" android:textColor="@color/text_primary" android:textSize="9sp" />
        <TextView android:id="@+id/dockAI" android:layout_width="54dp" android:layout_height="48dp" android:gravity="center" android:text="✦\nAI" android:textColor="@color/text_primary" android:textSize="9sp" />
        <TextView android:id="@+id/dockSettings" android:layout_width="54dp" android:layout_height="48dp" android:gravity="center" android:text="⚙\nSET" android:textColor="@color/text_primary" android:textSize="9sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
