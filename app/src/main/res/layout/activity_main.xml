<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_jarvis">

    <!-- Ambient motion bubbles -->
    <com.jarvisai.MotionBubbleView
        android:id="@+id/motionBubbles"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.20"
        android:clickable="false"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TOP HEADER BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="JARVIS OS logo"
            android:padding="2dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arc_reactor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="JARVIS OS"
                android:textColor="#F1F8FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your AI Assistant. Always With You."
                android:textColor="#38BDF8"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aiCard"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/pill_model_status"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Gemini AI"
                android:src="@drawable/ic_gemini_sparkle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Gemini 3.8 Flash"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#10B981"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="10:24"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MAIN SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/composerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Voice Orb Hologram Card -->
            <LinearLayout
                android:id="@+id/cardVoiceOrb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/card_glass_panel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="90dp">

                    <com.jarvisai.VoiceOrbView
                        android:id="@+id/voiceOrb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/orbStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Say &quot;Hey JARVIS&quot; to activate"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Greeting Banner -->
            <LinearLayout
                android:id="@+id/cardGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_glass_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="JARVIS"
                    android:src="@drawable/ic_arc_reactor" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, I&apos;m JARVIS"
                        android:textColor="#F1F8FF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Your personal AI assistant powered by Gemini 3.8 Flash."
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4 Quick Prompt Action Chips -->
            <LinearLayout
                android:id="@+id/promptChipsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipThink"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/prompt_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="💡 Think
Better"
                    android:textColor="#E0F2FE"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/chipSearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/prompt_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🔍 Search
The Web"
                    android:textColor="#E0F2FE"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/chipCreate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/prompt_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✏️ Create
Anything"
                    android:textColor="#E0F2FE"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/chipControl"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/prompt_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="📲 Control
Device"
                    android:textColor="#E0F2FE"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Chat Messages Container -->
            <LinearLayout
                android:id="@+id/chatMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- Message 1: User -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chat_bubble_user"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="open YouTube    10:24 AM  ✓✓"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="User Avatar"
                        android:src="@drawable/ic_user_avatar" />
                </LinearLayout>

                <!-- Message 1: JARVIS Response & YouTube Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="JARVIS Avatar"
                        android:src="@drawable/ic_arc_reactor" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="340dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chat_bubble_ai"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="Opening YouTube for you...    10:24 AM"
                            android:textColor="#F1F8FF"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/cardYoutubeResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/card_youtube_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:contentDescription="YouTube"
                                android:src="@drawable/ic_youtube" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="YouTube"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="App opened successfully."
                                    android:textColor="#94A3B8"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Success"
                                android:src="@drawable/ic_check_circle" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Message 2: Live Response text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="JARVIS Avatar"
                        android:src="@drawable/ic_arc_reactor" />

                    <TextView
                        android:id="@+id/responseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chat_bubble_ai"
                        android:lineSpacingExtra="3dp"
                        android:maxWidth="340dp"
                        android:padding="12dp"
                        android:text="A black hole is a place in space where gravity is so strong that nothing — not even light — can escape from it.

• Forms when a massive star collapses.
• Center is called a singularity.
• Edge is called the event horizon.

In short: it&apos;s like a cosmic vacuum with super-strong gravity.    10:24 AM"
                        android:textColor="#F1F8FF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Actions Grid -->
            <LinearLayout
                android:id="@+id/cardQuickActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_glass_panel"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Quick Actions"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/actionOpenApps"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="▦
Open Apps"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/cameraCard"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="📷
Take Photo"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/actionRecord"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="🎙
Record"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/actionShareScreen"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="💻
Share Screen"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/actionLiveCamera"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="📹
Live Camera"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/devCard"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="ℹ
System Info"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/settingsCard"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="⚙
Settings"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/actionMore"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_action_tile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="•••
More"
                        android:textColor="#E0F2FE"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- System Status Card -->
            <LinearLayout
                android:id="@+id/cardSystemStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_glass_panel"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="System Status"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Battery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Battery"
                        android:src="@drawable/ic_battery" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:text="Battery"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/textBatteryPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="92%"
                        android:textColor="#10B981"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBattery"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="92"
                    android:progressDrawable="@drawable/status_progress_green" />

                <!-- Storage -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Storage"
                        android:src="@drawable/ic_storage" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:text="Storage"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/textStorageUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42.6 GB / 128 GB"
                        android:textColor="#38BDF8"
                        android:textSize="9sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressStorage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="33"
                    android:progressDrawable="@drawable/status_progress_cyan" />

                <!-- Network -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Network"
                        android:src="@drawable/ic_wifi" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:text="Network"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/textNetworkStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wi-Fi"
                        android:textColor="#10B981"
                        android:textSize="10sp" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/status_progress_green" />

                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Location"
                        android:src="@drawable/ic_location" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:text="Location"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/textLocationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="On"
                        android:textColor="#10B981"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Profile & Good Morning Card -->
            <FrameLayout
                android:id="@+id/personalCard"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_cosmic_mountain"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="GOOD MORNING"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="AKARSH"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Your future is built
by what you do today."
                        android:textColor="#BAE6FD"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnProfileArrow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/btn_circle_arrow"
                    android:contentDescription="Action arrow"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_forward" />
            </FrameLayout>

            <!-- Quote Card -->
            <LinearLayout
                android:id="@+id/cardQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_cosmic_mountain"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;The best way to predict
the future is to create it.&quot;"
                    android:textColor="#F1F8FF"
                    android:textSize="10sp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="— JARVIS"
                    android:textColor="#38BDF8"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Compatibility views -->
            <View android:id="@+id/defaultAssistantCard" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/defaultAssistantTitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/defaultAssistantSubtitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/automationCard" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/apiCard" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM COMPOSER BAR -->
    <LinearLayout
        android:id="@+id/composerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#DD020611"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/dock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/listenButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_circle_mic"
            android:contentDescription="Voice Input"
            android:padding="10dp"
            android:src="@drawable/ic_mic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/card_glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Type a message or say &quot;Hey JARVIS...&quot;"
                android:imeOptions="actionSend"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="#F1F8FF"
                android:textColorHint="#64748B"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btnAttachment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Attach File"
                android:src="@drawable/ic_paperclip" />

            <ImageView
                android:id="@+id/btnGallery"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Gallery Image"
                android:src="@drawable/ic_image" />

            <Button
                android:id="@+id/voiceModeButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_circle_send"
            android:contentDescription="Send Command"
            android:padding="11dp"
            android:src="@drawable/ic_send_arrow" />
    </LinearLayout>

    <!-- BOTTOM NAVIGATION DOCK -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#F5020611"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dockHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⌂
Home"
            android:textColor="#24E8FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dockVoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="💬
Chat"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/dockApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▦
Apps"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/dockAI"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🛠
Tools"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/dockSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚙
Settings"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
